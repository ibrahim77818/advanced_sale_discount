<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_asd" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.advanced_sale_discount</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="asd_discount_enabled" invisible="1"/>
                <field name="asd_discount_mode" invisible="1"/>
                <field name="asd_discount_stale" invisible="1"/>
                <field name="asd_discount_fingerprint" invisible="1"/>
                <button name="action_open_asd_discount_wizard" type="object" string="Apply Discount"
                        groups="advanced_sale_discount.group_sale_discount_user"
                        attrs="{'invisible': ['|', ('asd_discount_enabled', '=', False), ('state', 'not in', ('draft', 'sent', 'sale'))]}"/>
                <button name="action_asd_reset_discount" type="object" string="Remove Discount"
                        groups="advanced_sale_discount.group_sale_discount_user"
                        confirm="Remove the global discount from this order?"
                        attrs="{'invisible': ['|', ('asd_discount_mode', '=', False), ('state', 'not in', ('draft', 'sent', 'sale'))]}"/>
            </xpath>
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning mb-0" role="alert"
                     attrs="{'invisible': [('asd_discount_stale', '=', False)]}">
                    The order lines changed after the global discount was applied, so the discount no longer matches them. Use "Apply Discount" again, or "Remove Discount", before confirming the order.
                </div>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree/field[@name='price_subtotal']" position="before">
                <field name="asd_is_discount_line" invisible="1"/>
                <field name="asd_extra_discount" optional="hide"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Global Discount" name="asd_global_discount"
                      attrs="{'invisible': [('asd_discount_mode', '=', False)]}">
                    <group>
                        <group>
                            <field name="asd_discount_mode"/>
                            <field name="asd_discount_type"/>
                            <field name="asd_discount_value"/>
                            <field name="asd_discount_amount_base"/>
                        </group>
                        <group>
                            <field name="asd_discount_target"/>
                            <field name="asd_discount_total"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
