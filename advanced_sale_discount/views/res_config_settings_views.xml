<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_asd" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.advanced_sale_discount</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='sale_management']" position="inside">
                <block title="Advanced Discounts" name="asd_discount_setting_container">
                    <setting id="asd_discount_setting"
                             help="Apply percentage or fixed discounts on sales orders and customer invoices">
                        <field name="asd_discount_enabled"/>
                        <div class="content-group" invisible="not asd_discount_enabled">
                            <div class="row mt16">
                                <label for="asd_discount_product_id" class="col-lg-4 o_light_label"/>
                                <field name="asd_discount_product_id"
                                       required="asd_discount_enabled"
                                       context="{'default_type': 'service', 'default_invoice_policy': 'order', 'default_sale_ok': True, 'default_purchase_ok': False}"/>
                            </div>
                            <div class="text-muted">
                                Service product with an income account, used on discount and rounding lines
                            </div>
                            <div class="mt8">
                                <button name="%(advanced_sale_discount.action_sale_discount_tier_rule)d" type="action"
                                        string="Volume Discount Rules" icon="oi-arrow-right" class="btn-link"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
