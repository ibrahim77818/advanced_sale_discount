<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_discount_tier_rule_view_tree" model="ir.ui.view">
        <field name="name">sale.discount.tier.rule.tree</field>
        <field name="model">sale.discount.tier.rule</field>
        <field name="arch" type="xml">
            <tree string="Volume Discount Rules">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="scope"/>
                <field name="basis"/>
                <field name="partner_ids" widget="many2many_tags" optional="show"/>
                <field name="date_start" optional="show"/>
                <field name="date_end" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="sale_discount_tier_rule_view_form" model="ir.ui.view">
        <field name="name">sale.discount.tier.rule.form</field>
        <field name="model">sale.discount.tier.rule</field>
        <field name="arch" type="xml">
            <form string="Volume Discount Rule">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger"
                            invisible="active"/>
                    <field name="active" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Wholesale volume discount"/></h1>
                    </div>
                    <group>
                        <group string="Evaluation">
                            <field name="scope" widget="radio"/>
                            <field name="basis" widget="radio"/>
                            <field name="sequence"/>
                        </group>
                        <group string="Validity">
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Applies To">
                        <field name="partner_ids" widget="many2many_tags"/>
                        <field name="product_ids" widget="many2many_tags"/>
                        <field name="categ_ids" widget="many2many_tags"/>
                    </group>
                    <notebook>
                        <page string="Tiers" name="tiers">
                            <field name="tier_ids">
                                <tree editable="bottom">
                                    <field name="min_value"/>
                                    <field name="discount_percent"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" nolabel="1" placeholder="Internal notes about this agreement"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sale_discount_tier_rule_view_search" model="ir.ui.view">
        <field name="name">sale.discount.tier.rule.search</field>
        <field name="model">sale.discount.tier.rule</field>
        <field name="arch" type="xml">
            <search string="Volume Discount Rules">
                <field name="name"/>
                <field name="partner_ids"/>
                <field name="product_ids"/>
                <field name="categ_ids"/>
                <filter string="Contract Rules" name="contract" domain="[('partner_ids', '!=', False)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_sale_discount_tier_rule" model="ir.actions.act_window">
        <field name="name">Volume Discount Rules</field>
        <field name="res_model">sale.discount.tier.rule</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="sale_discount_tier_rule_view_search"/>
    </record>

    <menuitem id="menu_sale_discount_tier_rule"
              name="Volume Discount Rules"
              parent="sale.menu_sale_config"
              action="action_sale_discount_tier_rule"
              groups="sales_team.group_sale_manager"
              sequence="40"/>
</odoo>
